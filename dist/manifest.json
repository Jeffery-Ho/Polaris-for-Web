{
  "manifest_version": 3,
  "name": "Polaris: AI Chat Navigator — Smart Headings & Quick Jump",
  "version": "0.48.1",
  "version_name": "0.48.1(194)",
  "description": "Show heading markers for supported AI web answers and jump to headings from the right edge.",
  "icons": {
    "16": "icons/gpt-voyager-icon-16.png",
    "32": "icons/gpt-voyager-icon-32.png",
    "48": "icons/gpt-voyager-icon-48.png",
    "128": "icons/gpt-voyager-icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://www.doubao.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://yb.tencent.com/*",
    "https://yuanbao.tencent.com/*",
    "https://diandian.xiaohongshu.com/*",
    "https://www.xiaohongshu.com/*",
    "https://www.askdiandian.com/*",
    "https://www.diandianlife.top/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://diandian.xiaohongshu.com/*",
        "https://kimi.com/*",
        "https://qianwen.com/*",
        "https://www.askdiandian.com/*",
        "https://www.diandianlife.top/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://www.qianwen.com/*",
        "https://www.xiaohongshu.com/*",
        "https://yb.tencent.com/*",
        "https://yuanbao.tencent.com/*"
      ],
      "resources": [
        "icons/gpt-voyager-icon-96.png",
        "src/route-bridge.js",
        "assets/i18n.js",
        "assets/content.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_scripts": [
    {
      "js": [
        "assets/i18n.js",
        "assets/content.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://yb.tencent.com/*",
        "https://yuanbao.tencent.com/*",
        "https://diandian.xiaohongshu.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.askdiandian.com/*",
        "https://www.diandianlife.top/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
