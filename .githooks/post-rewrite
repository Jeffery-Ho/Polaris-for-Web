#!/bin/sh
# git rebase and git commit --amend pass rewritten commits on stdin.

if [ ! -t 0 ]; then
  cat >/dev/null
fi

if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
prev=$(git rev-parse -q --verify ORIG_HEAD 2>/dev/null) || prev=""
sh "$root/scripts/refresh-extension.sh" rewrite "$prev" HEAD
exit 0
